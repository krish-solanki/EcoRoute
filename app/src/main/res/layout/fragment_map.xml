<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragments.MapFragment">

    <!-- Full Screen Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/osmMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Location Search Panel (currently hidden) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:id="@+id/viewStatusBarMapFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <LinearLayout
            android:id="@+id/locationSearchPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_margin="16dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/bg_map_search_panel"
            android:elevation="10dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plan your eco-friendly route"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Location Fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Origin and Destination Indicators -->
                <LinearLayout
                    android:layout_width="24dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_map_origin_dot" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="32dp"
                        android:background="@color/divider" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_map_destination_dot" />
                </LinearLayout>

                <!-- Inputs -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Starting Location -->
                    <EditText
                        android:id="@+id/etCurrentLocation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_map_location_input"
                        android:hint="Choose starting location"
                        android:text="Current location"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:paddingHorizontal="12dp"
                        android:inputType="text"
                        android:drawableEnd="@android:drawable/ic_menu_mylocation"
                        android:focusable="false"
                        android:clickable="true" />

                    <!-- Destination -->
                    <EditText
                        android:id="@+id/etDestination"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_map_location_input"
                        android:hint="Search destination"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary"
                        android:textSize="14sp"
                        android:singleLine="true"
                        android:paddingHorizontal="12dp"
                        android:inputType="text"
                        android:imeOptions="actionSearch" />
                </LinearLayout>

                <!-- Swap Locations -->
                <ImageButton
                    android:id="@+id/btnSwapLocations"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="8dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_map_icon_button"
                    android:src="@drawable/swap_location"
                    android:contentDescription="Swap locations" />
            </LinearLayout>

            <!-- Search Route -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSearchRoute"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="Find Eco Route"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_map_search_button" />
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Progress Banner -->
    <TextView
        android:id="@+id/navigationStatusPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="60dp"
        android:padding="16dp"
        android:background="@drawable/bg_map_search_panel"
        android:elevation="8dp"
        android:text="Navigation starting…"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="invisible" />

    <!-- Get Started: Visible when route is ready -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_map_search_button"
        android:elevation="10dp"
        android:visibility="gone" />

    <!-- Navigation Controls -->
    <LinearLayout
        android:id="@+id/navigationControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <!-- Cancel: Left -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCancelNavigation"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_map_search_button"
            android:elevation="8dp" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Recenter: Right -->
        <ImageButton
            android:id="@+id/btnNavigationRecenter"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_map_icon_button"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="Recenter navigation"
            android:elevation="8dp" />
    </LinearLayout>

    <!-- Normal Map Location Button -->
    <ImageButton
        android:id="@+id/btnCurrentLocation"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_map_icon_button"
        android:src="@android:drawable/ic_menu_mylocation"
        android:contentDescription="Open route search"
        android:elevation="8dp" />

</FrameLayout>
