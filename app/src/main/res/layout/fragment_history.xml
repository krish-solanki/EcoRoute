<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/history_bg"
    tools:context=".ui.fragments.HistoryFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <View
            android:id="@+id/viewStatusBarHeightHistoryFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>

        <!-- EcoRoute Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/history_logo"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eco-Route"
                    android:textColor="@color/text_brand"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Breathe Better. Travel Smarter."
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- History Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Search -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/history_search_bg"
            android:paddingHorizontal="15dp"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:src="@drawable/search_outline"
                android:contentDescription="@string/search_history"/>

            <EditText
                android:id="@+id/historySearchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="@string/search_history"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp"
                android:singleLine="true"
                android:background="@android:color/transparent"
                android:inputType="text"
                android:imeOptions="actionSearch"/>
        </LinearLayout>

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="35dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/historyFilterAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:gravity="center"
                android:text="@string/history_filter_all"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/history_filter_selected"/>

            <TextView
                android:id="@+id/historyFilterSearched"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.3"
                android:gravity="center"
                android:text="@string/history_filter_searched"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                android:background="@drawable/history_filter_unselected"/>

            <TextView
                android:id="@+id/historyFilterStarted"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:gravity="center"
                android:text="@string/history_filter_started"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                android:background="@drawable/history_filter_unselected"/>
        </LinearLayout>

        <!-- Recent Activity -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/history_recent_activity"
            android:textColor="@color/text_brand"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Route History List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/historyRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/route_history_layout"/>

    </LinearLayout>

</FrameLayout>