<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/locationSearchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/card_background"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Plan your route"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnCloseSearch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Close"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- Route points -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="Starting point"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvStartLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/bg_map_location_input"
                android:text="Choose starting point"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>

        <View
            android:layout_width="12dp"
            android:layout_height="1dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:text="Destination"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvDestinationLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:background="@drawable/bg_map_location_input"
                android:text="Choose destination"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"/>

        </LinearLayout>
    </LinearLayout>

    <!-- Search active location -->
    <TextView
        android:id="@+id/tvSearchTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search starting point"
        android:textColor="@color/text_brand"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/etLocationSearch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_map_location_input"
        android:padding="14dp"
        android:hint="Search location..."
        android:singleLine="true"
        android:inputType="text"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"/>

    <TextView
        android:id="@+id/tvUseCurrentLocation"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:text="◎  Use my current location as starting point"
        android:textColor="@color/text_brand"
        android:textSize="14sp"
        android:paddingStart="4dp"/>

    <ProgressBar
        android:id="@+id/locationSearchProgress"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvLocationSearchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search for a location"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <ListView
        android:id="@+id/locationSuggestionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/divider"
        android:dividerHeight="1dp"
        android:background="@android:color/transparent"
        android:overScrollMode="never"/>

    <Button
        android:id="@+id/btnFindShortestRoute"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Find Shortest Route"
        android:textAllCaps="false"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/button_primary"/>

    <TextView
        android:id="@+id/tvRouteDistance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="12dp"
        android:text="Distance will appear here"
        android:textColor="@color/text_brand"
        android:textStyle="bold"
        android:textSize="16sp"/>

</LinearLayout>
